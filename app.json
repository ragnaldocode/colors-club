{
  "expo": {
    "name": "Colors Club",
    "slug": "colors-club",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "colorsclub",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ragnaldocode.colorsclub",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ragnaldocode.colorsclub",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF7F0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Colors Club",
      "shortName": "Colors Club",
      "themeColor": "#FF6F5B",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
